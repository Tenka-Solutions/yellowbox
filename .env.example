NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SMK Vending
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Frontend Next/Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor Next/admin. No exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Next API solo para desarrollo local. En produccion estas rutas quedan bloqueadas.
# El flujo real de pedidos/pagos usa NEXT_PUBLIC_API_BASE_URL hacia hubcafe-backend.
PAYMENTS_MODE=mock
GETNET_COMMERCE_ID=
GETNET_API_KEY=
GETNET_API_URL=
GETNET_RETURN_URL=http://localhost:3000/api/payments/getnet/return
GETNET_WEBHOOK_URL=http://localhost:3000/api/payments/getnet/webhook

# Mercado Pago Checkout Pro. No uses localhost en NEXT_PUBLIC_SITE_URL
# para pruebas reales: Mercado Pago debe poder alcanzar el webhook publico.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_INTEGRATOR_ID=dev_24c65fb163bf11ea96500242ac130004
MERCADOPAGO_CERTIFICATION_EXTERNAL_REFERENCE_EMAIL=certification@example.com
MERCADOPAGO_WEBHOOK_SECRET=

EMAIL_MODE=log
RESEND_API_KEY=
RESEND_FROM=no-reply@smkvending.cl

ADMIN_ALLOWED_EMAILS=
